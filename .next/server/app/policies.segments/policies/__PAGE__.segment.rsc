3:["$","ul",null,{"children":[["$","li","A $30.00 deposit is required to secure and keep every appointment. Your slot is not reserved until the deposit is paid.",{"children":"A $30.00 deposit is required to secure and keep every appointment. Your slot is not reserved until the deposit is paid."}],["$","li","Pay the deposit online by card, Apple Pay or Link when you book on this website — your time is locked instantly.",{"children":"Pay the deposit online by card, Apple Pay or Link when you book on this website — your time is locked instantly."}],["$","li","Prefer Cash App ($peacejoybraids) or Zelle (410-671-1788)? Text 410-671-1788 to book that way; your appointment is confirmed once we receive the deposit.",{"children":"Prefer Cash App ($peacejoybraids) or Zelle (410-671-1788)? Text 410-671-1788 to book that way; your appointment is confirmed once we receive the deposit."}],["$","li","The deposit is non-refundable and counts toward the total price of your style.",{"children":"The deposit is non-refundable and counts toward the total price of your style."}],["$","li","No call / no show = appointment canceled, and the deposit is automatically forfeited.",{"children":"No call / no show = appointment canceled, and the deposit is automatically forfeited."}]]}]
