2:Td0f,{"@context":"https://schema.org","@type":"FAQPage","@id":"https://braidsbypeacejoy.com/faq#faq","mainEntity":[{"@type":"Question","name":"How do I book an appointment?","acceptedAnswer":{"@type":"Answer","text":"Choose your style, pick an open date and time, and pay the $30.00 deposit to lock your slot — it takes a few minutes. You can also call or text 410-671-1788."}},{"@type":"Question","name":"Is a deposit required, and is it refundable?","acceptedAnswer":{"@type":"Answer","text":"Yes. A strict, non-refundable $30.00 deposit secures your slot and counts toward your total price. A no call / no show forfeits the deposit."}},{"@type":"Question","name":"Can I cancel or reschedule?","acceptedAnswer":{"@type":"Answer","text":"Yes — reply to your confirmation email or text 410-671-1788 at least 72 hours before your appointment. Later cancellations need a new deposit to book again."}},{"@type":"Question","name":"What payment methods do you accept?","acceptedAnswer":{"@type":"Answer","text":"Online: Visa, Mastercard, American Express, Discover, Apple Pay and Link, processed securely by Stripe. Deposits can also be sent by Cash App ($peacejoybraids) or Zelle (410-671-1788) — text us to book that way."}},{"@type":"Question","name":"How do I pay the rest of my balance?","acceptedAnswer":{"@type":"Answer","text":"Pay online at any time using the email or phone number you booked with, or your booking code; send it by Cash App ($peacejoybraids) or Zelle (410-671-1788) with your booking code in the note, or pay at your appointment."}},{"@type":"Question","name":"How should I prepare for my appointment?","acceptedAnswer":{"@type":"Answer","text":"Arrive with your hair washed and blow-dried, with no oil or product applied. Your hair should be at least 4 inches long."}},{"@type":"Question","name":"What if I'm running late?","acceptedAnswer":{"@type":"Answer","text":"Please call or text 410-671-1788 as soon as you can so we can plan around it."}},{"@type":"Question","name":"I have an allergy to braiding hair or products. What should I do?","acceptedAnswer":{"@type":"Answer","text":"Tell us before your appointment — add it in the notes when you book, or text us — so we can use suitable hair and products."}},{"@type":"Question","name":"What styles do you offer?","acceptedAnswer":{"@type":"Answer","text":"Knotless braids, boho and curly styles, box braids, cornrows and stitch braids, twists and locs, and kids styles. Browse the full menu by category."}},{"@type":"Question","name":"Is braiding hair included in the price?","acceptedAnswer":{"@type":"Answer","text":"Yes, except for passion twists and crochet styles. When you book you can upgrade to 100% human hair ($80 per bundle) or blended hair ($50 per bundle), or bring your own. A mix of 2+ colors adds $20."}},{"@type":"Question","name":"Do you braid children's hair?","acceptedAnswer":{"@type":"Answer","text":"Yes — see the Kids category on the style menu."}},{"@type":"Question","name":"Where are you located?","acceptedAnswer":{"@type":"Answer","text":"Inside PHENIX Salon Suites at 8700 Liberty Rd, Suite 101, Randallstown, MD 21133."}},{"@type":"Question","name":"What are your opening hours?","acceptedAnswer":{"@type":"Answer","text":"Monday to Sunday, 8:00 AM to 7:00 PM, by appointment. Every style is scheduled to finish by 7:00 PM."}}]}8:X
