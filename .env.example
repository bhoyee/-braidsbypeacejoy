# ───────────── Shared ─────────────
# Public URL of the site. Used for Stripe redirects + email links.
# On the server, deploy/bootstrap.sh writes ~/bbpj-api/.env for you; this file is for local dev.
NEXT_PUBLIC_SITE_URL="https://braidsbypeacejoy.com"

# ───────────── Optional: split frontend hosting ─────────────
# Origin of the cPanel Node app. When set, /api/* is proxied there and the
# style menu is fetched from it. Leave UNSET on cPanel and for all-in-one local dev.
# API_ORIGIN="https://api.braidsbypeacejoy.com"

# ───────────── cPanel (backend) ─────────────
# cPanel → MySQL Databases. Format: mysql://USER:PASSWORD@HOST:3306/DBNAME
DATABASE_URL="mysql://cpaneluser_bbpj:CHANGE_ME@localhost:3306/cpaneluser_bbpj"

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Long random string; the cPanel cron job sends it as a Bearer token.
CRON_SECRET="generate-a-long-random-string"

# Notifications (optional — anything left blank is logged and skipped)
ADMIN_EMAIL="owner@braidsbypeacejoy.com"

# WhatsApp (optional). Chat button: the number visitors message (country code + number, digits only).
# If unset, the salon phone is used.
WHATSAPP_CHAT_NUMBER=""
# Booking alerts to the owner's WhatsApp via CallMeBot (free): number with +country code, and the
# API key CallMeBot sends you. See https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_ALERT_NUMBER=""
CALLMEBOT_API_KEY=""

# cPanel email account (Email Accounts → Connect Devices shows these values)
SMTP_HOST="mail.braidsbypeacejoy.com"
SMTP_PORT="465"
SMTP_USER="bookings@braidsbypeacejoy.com"
SMTP_PASS="CHANGE_ME"
EMAIL_FROM="\"Braidsbypeacejoy\" <bookings@braidsbypeacejoy.com>"


# ───────────── SEO ─────────────
# Google Search Console → Add property → HTML tag → paste only the content="…" value
GOOGLE_SITE_VERIFICATION=""
# Bing Webmaster Tools → HTML meta tag (msvalidate.01) value
BING_SITE_VERIFICATION=""
